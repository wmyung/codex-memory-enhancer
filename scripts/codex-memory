#!/bin/bash
# codex-memory: Codex wrapper with automatic memory context restoration
# Installed by: codex-memory-enhancer install.sh
# Usage: codex-memory [args...]

MEMORY_SCRIPT="$HOME/.codex/skills/local-memory/memory.py"

if [ ! -f "$MEMORY_SCRIPT" ]; then
    echo "Memory script not found at $MEMORY_SCRIPT"
    echo "Run install.sh first"
    exit 1
fi

echo "Restoring memory context..."
python3 "$MEMORY_SCRIPT" condense -n 5
echo ""
python3 "$MEMORY_SCRIPT" stats
echo ""

exec codex "$@"
